{
  "mcpServers": {
    "postman": {
      "command": "cmd.exe",
      "args": [
        "/c",
        "npx",
        "-y",
        "@postman/postman-mcp-server@latest"
      ]
    },
    "selenium": {
      "command": "npx",
      "args": [
        "-y",
        "@gaforov/selenium-mcp"
      ]
    },
    "serena": {
      "command": "serena",
      "args": [
        "start-mcp-server",
        "--context",
        "antigravity"
      ]
    }
  }
}
