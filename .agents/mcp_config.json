{
  "mcpServers": {
    "postman": {
      "command": "cmd.exe",
      "args": [
        "/c",
        "npx",
        "-y",
        "@postman/postman-mcp-server@latest",
        "--minimal"
      ],
      "env": {
        "POSTMAN_API_KEY": "$POSTMAN_API_KEY"
      }
    },
    "selenium": {
      "command": "npx",
      "args": [
        "-y",
        "@gaforov/selenium-mcp"
      ]
    },
    "serena": {
      "command": "serena",
      "args": [
        "start-mcp-server",
        "--context",
        "antigravity"
      ]
    }
  }
}
