# Per-instance settings. Copy to .env and fill in as needed.
# With no values set the app runs exactly as before (single instance).

# Chrome debugging endpoint the bot attaches to. A second parallel worker
# needs its own Chrome (its own --user-data-dir) and its own port.
AUTOPAGE_CHROME_DEBUG_HOST=localhost
AUTOPAGE_CHROME_DEBUG_PORT=8989

# Label used in logs to tell workers apart.
AUTOPAGE_WORKER_ID=default

# Where this instance writes mutable files (logs, caches, generated workbooks).
# Reserved for the parallel-worker rollout; the app still uses its own folder.
AUTOPAGE_DATA_DIR=
