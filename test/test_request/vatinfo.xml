												<xs:documentation>วันเดือนปีที่กรมสรรพากรอนุมัติให้ใช้สิทธิ์ได้</xs:documentation>
											</xs:annotation>
										</xs:element>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:choice>
		</xs:complexType>
	</xs:element>

	<xs:element name="VRTService">
		<xs:annotation>
			<xs:documentation xml:lang="en">Provide an information of business who get a right which foreigner tourists can get VAT refund after buying goods.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:choice>
				<xs:element name="InVRTData">
					<xs:annotation>
						<xs:documentation xml:lang="th">ข้อมูลนำเข้าเพื่อเรียกใช้บริการ</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element ref="Header"/>
							<xs:element name="ShopName" type="xs:string">
								<xs:annotation>
									<xs:documentation xml:lang="th">ชื่อร้านค้า</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="BusinessTypeCode" type="xs:string">
								<xs:annotation>
									<xs:documentation xml:lang="th">รหัสประเภทธุรกิจ</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="ProvinceCode" type="xs:int">
								<xs:annotation>
									<xs:documentation xml:lang="th">รหัสจังหวัด</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="StreetCode" type="xs:int">
								<xs:annotation>
									<xs:documentation xml:lang="th">รหัสถนน</xs:documentation>
								</xs:annotation>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="OutVRTData">
					<xs:annotation>
						<xs:documentation xml:lang="th">ข้อมูลที่ผู้ใช้จะได้รับ</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence maxOccurs="unbounded">
							<xs:element ref="Message"/>
							<xs:element name="VRTInfo">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="BusinessName" type="xs:string">
											<xs:annotation>
												<xs:documentation xml:lang="th">ชื่อสถานประกอบการ</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="ShopName" type="xs:string" minOccurs="0">
											<xs:annotation>
												<xs:documentation xml:lang="th">ชื่อร้าน</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="HouseNumber" type="xs:string">
											<xs:annotation>
												<xs:documentation xml:lang="th">เลขที่ตั้งของสถานประกอบการ</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="StreetName" type="xs:string">
											<xs:annotation>
												<xs:documentation xml:lang="th">ถนน</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="ThambolName" type="xs:string">
											<xs:annotation>
												<xs:documentation xml:lang="th">ตำบล</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="AmphurName" type="xs:string">
											<xs:annotation>
												<xs:documentation xml:lang="th">อำเภอ</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="ProvinceName" type="xs:string">
											<xs:annotation>
												<xs:documentation xml:lang="th">จังหวัด</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="PostCode" type="xs:string">
											<xs:annotation>
												<xs:documentation xml:lang="th">รหัสไปรษณีย์</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="BusinessTypeName" type="xs:string">
											<xs:annotation>
												<xs:documentation xml:lang="th">ชื่อประเภทธุรกิจ</xs:documentation>
											</xs:annotation>
										</xs:element>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:choice>
		</xs:complexType>
	</xs:element>

	<xs:element name="CITService">
		<xs:annotation>
			<xs:documentation xml:lang="en">Provide a basic information of company who is subject to CIT. Company are classified by 5 main industry which have received promotion from Board of Investment (BOI) of Thai Government.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:choice>
				<xs:element name="InCITData">
					<xs:annotation>
						<xs:documentation xml:lang="th">ข้อมูลนำเข้าเพื่อเรียกใช้บริการ</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element ref="Header"/>
							<xs:element ref="TIN"/>
							<xs:element name="ISICGroup">
								<xs:annotation>
									<xs:documentation xml:lang="th">ชื่อประเภทธุรกิจหลักที่รัฐบาลไทยให้การส่งเสริม</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:enumeration value="Food"/>
										<xs:enumeration value="Fashion"/>
										<xs:enumeration value="SoftwareElectronics"/>
										<xs:enumeration value="Vehicle"/>
										<xs:enumeration value="Tour"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="ProvinceCode" type="xs:int">
								<xs:annotation>
									<xs:documentation xml:lang="th">รหัสจังหวัด</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="TaxPayerName" type="xs:string">
								<xs:annotation>
									<xs:documentation xml:lang="th">ชื่อของผู้เสียภาษีอากร</xs:documentation>
								</xs:annotation>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="OutCITData">
					<xs:annotation>
						<xs:documentation xml:lang="th">ข้อมูลที่ผู้ใช้จะได้รับ</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:sequence maxOccurs="unbounded">
								<xs:element ref="Message"/>
								<xs:element name="CITInfo">
									<xs:annotation>
										<xs:documentation xml:lang="en">The system do not display TotalDirectRevenue and TaxComputeAmount if the selection is less than 10 taxpayers .</xs:documentation>
									</xs:annotation>
									<xs:complexType>
										<xs:sequence>
											<xs:element name="TaxYear" type="xs:string">
												<xs:annotation>
													<xs:documentation xml:lang="th">ปีภาษี</xs:documentation>
												</xs:annotation>
											</xs:element>
											<xs:element name="ISICGroup" type="xs:string">
												<xs:annotation>
													<xs:documentation xml:lang="th">ชื่อประเภทธุรกิจหลักที่รัฐบาลไทยให้การส่งเสริม</xs:documentation>
												</xs:annotation>
											</xs:element>
											<xs:element ref="TIN"/>
											<xs:element ref="FullName"/>
											<xs:element ref="Address"/>
										</xs:sequence>
									</xs:complexType>
								</xs:element>
							</xs:sequence>
							<xs:element name="CITSum">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="TotalDirectRevenue" type="xs:decimal">
											<xs:annotation>
												<xs:documentation xml:lang="th">ยอดรวมรายได้โดยตรงจากการประกอบกิจการ ทั้งจากกิจการที่ได้รับการยกเว้นภาษีเงินได้และที่ต้องเสียภาษีเงินได้</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="TaxComputeAmount" type="xs:decimal">
											<xs:annotation>
												<xs:documentation xml:lang="th">ยอดรวมจำนวนเงินภาษีที่คำนวณได้</xs:documentation>
											</xs:annotation>
										</xs:element>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:choice>
		</xs:complexType>
	</xs:element>

	<xs:element name="JointService">
		<xs:annotation>
			<xs:documentation xml:lang="en">Provide an information of joint venture company and juristic body incorporated under a foreign law company.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:choice>
				<xs:element name="InJointServiceData">
					<xs:annotation>
						<xs:documentation xml:lang="th">ข้อมูลนำเข้าเพื่อเรียกใช้บริการ</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:choice>
							<xs:sequence>
								<xs:element ref="Header"/>
								<xs:element name="TypeOfService">
									<xs:annotation>
										<xs:documentation xml:lang="en">foreigncompany or jointventure</xs:documentation>
									</xs:annotation>
									<xs:simpleType>
										<xs:restriction base="xs:string">
											<xs:enumeration value="foreigncompany"/>
											<xs:enumeration value="jointventure"/>
										</xs:restriction>
									</xs:simpleType>
								</xs:element>
								<xs:element ref="TIN"/>
								<xs:element name="TaxpayerName" type="xs:string">
									<xs:annotation>
										<xs:documentation xml:lang="th">ชื่อของผู้เสียภาษีอากร</xs:documentation>
									</xs:annotation>
								</xs:element>
							</xs:sequence>
							<xs:sequence>
								<xs:element ref="Header"/>
								<xs:element name="TypeOfService">
									<xs:annotation>
										<xs:documentation xml:lang="en">foreigncompany or JointVenture</xs:documentation>
									</xs:annotation>
									<xs:simpleType>
										<xs:restriction base="xs:string">
											<xs:enumeration value="foreigncompany"/>
											<xs:enumeration value="jointventure"/>
										</xs:restriction>
									</xs:simpleType>
								</xs:element>
								<xs:element name="TINs" type="TINType"/>
							</xs:sequence>
						</xs:choice>
					</xs:complexType>
				</xs:element>
				<xs:element name="OutInJointServiceData">
					<xs:annotation>
						<xs:documentation xml:lang="th">ข้อมูลที่ผู้ใช้จะได้รับ</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence maxOccurs="unbounded">
							<xs:element ref="Message"/>
							<xs:element name="JointServiceInfo">
								<xs:complexType>
									<xs:sequence>
										<xs:element ref="TIN"/>
										<xs:element ref="FullName"/>
										<xs:element ref="Address"/>
										<xs:element name="ISICDescription" type="xs:string">
											<xs:annotation>
												<xs:documentation xml:lang="th">ชื่อประเภทกิจการ</xs:documentation>
											</xs:annotation>
										</xs:element>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:choice>
		</xs:complexType>
	</xs:element>

	<xs:element name="TCLService">
		<xs:annotation>
			<xs:documentation xml:lang="en">Provide an information of tax collection which collected by Revenue Department and summary into tax type and tax collection form.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:choice>
				<xs:element name="InTCLData">
					<xs:annotation>
						<xs:documentation xml:lang="th">ข้อมูลนำเข้าเพื่อเรียกใช้บริการ</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element ref="Header"/>
							<xs:element name="ReceiveDate">
								<xs:annotation>
									<xs:documentation xml:lang="en">ReceiveDate must be in the A.D. year. The format is yyyy/mm/dd (Ex. 2005/05/30) .</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:pattern value="[0-9]{4}[/][0-9]{2}[/][0-9]{2}"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="OfficeCode">
								<xs:annotation>
									<xs:documentation xml:lang="th">รหัสหน่วยงานที่รับแบบแสดงรายการภาษี</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:length value="8"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="FormCode">
								<xs:annotation>
									<xs:documentation xml:lang="th">รหัสแบบแสดงรายการภาษี</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:length value="5"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="Source_Data">
								<xs:annotation>
									<xs:documentation xml:lang="th">ที่มาของข้อมูล</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:length value="2"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="OutTCLData">
					<xs:annotation>
						<xs:documentation xml:lang="th">ข้อมูลที่ผู้ใช้จะได้รับ</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence maxOccurs="unbounded">
							<xs:element ref="Message"/>
							<xs:element name="TCLInfo">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="ReceiveDate" type="xs:string">
											<xs:annotation>
												<xs:documentation xml:lang="th">วันที่รับแบบแสดงรายการภาษี</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="OfficeName" type="xs:string">
											<xs:annotation>
												<xs:documentation xml:lang="th">ชื่อหน่วยงานที่รับแบบแสดงรายการภาษี</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="FormCode" type="xs:string">
											<xs:annotation>
												<xs:documentation xml:lang="th">รหัสแบบแสดงรายการภาษี</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="Source_Data" type="xs:string">
											<xs:annotation>
												<xs:documentation xml:lang="th">ที่มาของข้อมูล</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="ReceiveAmount" type="xs:decimal">
											<xs:annotation>
												<xs:documentation xml:lang="th">จำนวนเงินที่ได้รับชำระ</xs:documentation>
											</xs:annotation>
										</xs:element>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:choice>
		</xs:complexType>
	</xs:element>

	<xs:element name="Message" type="MessageType"/>
	<xs:complexType name="MessageType">
		<xs:sequence maxOccurs="unbounded">
			<xs:element name="Code" type="xs:string"/>
			<xs:element name="Description" type="xs:string"/>
		</xs:sequence>
	</xs:complexType>

	<xs:element name="Address" type="AddressType"/>
	<xs:complexType name="AddressType">
		<xs:sequence>
			<xs:element name="BuildingName" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation xml:lang="th">ชื่ออาคาร</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RoomNumber" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation xml:lang="th">ห้องเลขที่</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FloorNumber" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation xml:lang="th">ชั้นที่</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VillageName" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation xml:lang="th">หมู่บ้าน</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="HouseNumber" type="xs:string">
				<xs:annotation>
					<xs:documentation xml:lang="th">บ้านเลขที่</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MooNumber" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation xml:lang="th">หมู่ที่</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SoiName" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation xml:lang="th">ซอย</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StreetName" type="xs:string">
				<xs:annotation>
					<xs:documentation xml:lang="th">ถนน</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ThambolName" type="xs:string">
				<xs:annotation>
					<xs:documentation xml:lang="th">ตำบล</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AmphurName" type="xs:string">
				<xs:annotation>
					<xs:documentation xml:lang="th">อำเภอ</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProvinceName" type="xs:string">
				<xs:annotation>
					<xs:documentation xml:lang="th">จังหวัด</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PostCode" type="xs:string">
				<xs:annotation>
					<xs:documentation xml:lang="th">รหัสไปรษณีย์</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:element name="FullName" type="NameType"/>
	<xs:complexType name="NameType">
		<xs:sequence>
			<xs:element name="TitleName" type="xs:string">
				<xs:annotation>
					<xs:documentation xml:lang="th">คำนำหน้าชื่อ</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TaxPayerName" type="xs:string">
				<xs:annotation>
					<xs:documentation xml:lang="th">ชื่อของผู้ประกอบการ</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SurName" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation xml:lang="th">นามสกุลของผู้ประกอบการ</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:element name="Header" type="HeaderType"/>
	<xs:complexType name="HeaderType">
		<xs:sequence>
			<xs:element ref="username"/>
			<xs:element ref="password"/>
		</xs:sequence>
	</xs:complexType>

	<xs:element name="username" type="UsernameType"/>
	<xs:simpleType name="UsernameType">
		<xs:restriction base="xs:string">
			<xs:pattern value="[a-z0-9]*"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:element name="password" type="PasswordType"/>
	<xs:simpleType name="PasswordType">
		<xs:restriction base="xs:string">
			<xs:minLength value="8"/>
			<xs:pattern value="[a-z0-9]*"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:element name="TIN" type="TINType">
		<xs:annotation>
			<xs:documentation xml:lang="en">Tax Identification Number 13 digits</xs:documentation>
		</xs:annotation>
	</xs:element>

	<xs:simpleType name="TINType">
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9]{13}"/>
		</xs:restriction>
	</xs:simpleType>
</xs:schema>