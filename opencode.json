{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "lsp": true,
  "plugin": [
    "@falentio/opencode-pstack@0.7.0"
  ],
  "mcp": {
    "typesafe-docs": {
      "type": "remote",
      "url": "https://docs.typesafe.ai/mcp",
      "enabled": true,
      "timeout": 30000
    },
    "jev": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "jev-judge-mcp"
      ],
      "enabled": true,
      "timeout": 30000,
      "environment": {
        "TYPESAFE_API_KEY": "{env:TYPESAFE_API_KEY}"
      }
    }
  }
}